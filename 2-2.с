#include <stdio.h>
#include <math.h>

double calc_y(double a, double x) {
if (a * x < 1) {
return a * sin((x * x + 1) / 10);
} else {
return a * cos((x - 1) / 10);
}
}

int main() {
double a = 0.3;
double x;

printf("Enter x: ");

if (scanf("%lf", &x) != 1) {
printf("Error: incorrect input\n");
return 1;
}

double y = calc_y(a, x);

printf("y = %.6f\n", y);

return 0;
}
